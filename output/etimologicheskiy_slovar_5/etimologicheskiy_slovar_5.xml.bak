        </cit>
        <cit type="bibl">
          <bibl>(Plet. 1, 265)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ces" type="old">ст.-чеш. <ref>del</ref>, род. п. dcefe, ж. p.</orth>
        </form>
        <sense>
