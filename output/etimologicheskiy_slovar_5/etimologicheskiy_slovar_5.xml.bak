      <item>
        <form>
          <orth xml:lang="mac" type="dialect">диал. <ref>друшка</ref>
          </orth>
        </form>
        <cit type="bibl">
          <bibl>(Видоески. Иоречкиот говор 59)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="srp">сербохорв. <ref>друшка</ref> ж. р.</orth>
