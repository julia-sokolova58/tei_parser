          <ref>-та</ref>
        </m>, 
соотносительное с <ref type="etymon" target="drobiti">* drobiti</ref>, 
<ref type="etymon" target="drobb-2">*drobb</ref>, 
<ref type="etymon" target="drobb-2">*drobb</ref> (см.).</gram>
    </gramGrp>
