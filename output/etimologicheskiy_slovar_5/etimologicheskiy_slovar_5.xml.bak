  <entry xml:id="dureti">
    <pb n="160" end_page="161" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dureti</orth>
      <lemma>dureti</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="slv">словен. <ref>dureti</ref> ступо, бесмысленно смотреть</orth>
        </form>
