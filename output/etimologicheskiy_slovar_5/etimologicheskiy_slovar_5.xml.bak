        </form>
        <sense>
          <def>надзор, контроль</def>
        </sense>
        <cit type="bibl">
          <bibl>(Dorosz. II, 337)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="svc">словин. <ref>dugzor</ref> м. р.</orth>
        </form>
        <sense>
          <def>надзор</def>
        </sense>
