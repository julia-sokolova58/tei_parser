        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="srp">сербохорв. <ref>Дуна</ref>] м. р., также Дунае м. р., Дунаво ср. р.</orth>
        </form>
        <sense>
          <def>Дунай, Дунае м. р</def>
