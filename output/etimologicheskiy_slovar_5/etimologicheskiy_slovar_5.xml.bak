        </form>
        <cit type="bibl">
          <bibl>(Сб. 1076 г., Срезневский I, 666)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="rus">русск. обл. <ref>дйра</ref> ж. р.</orth>
        </form>
