        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="slk" type="dialect">диал. <ref>drej</ref> , drel(ej), drelek</orth>
        </form>
        <cit type="bibl">
          <bibl>(HabovStiak. Orav. 25, 125, 296)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Stanislav. Liptov. 33)</bibl>
        </cit>
      </item>
