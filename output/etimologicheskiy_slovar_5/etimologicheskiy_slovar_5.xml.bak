    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>доволок</ref>
          </orth>
        </form>
        <sense>
          <def>удовольствовать</def>
        </sense>
        <cit type="bibl">
          <bibl>(Геров)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="srp" type="old">сербохорв. стар. , редк. <ref>dovoiti</ref>
          </orth>
        </form>
        <sense>
          <def>позволить, разрешить , dovoliti se быть довольным, удовлетвориться</def>
        </sense>
        <cit type="bibl">
          <bibl>(RJA И, 726)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(там же)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="slv">словен. <ref>dovoliti</ref>
          </orth>
        </form>
        <sense>
          <def>позволить, разрешить</def>
        </sense>
        <cit type="bibl">
          <bibl>(Plet. I, 164)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ces">чеш. <ref>dovoliti</ref>
          </orth>
        </form>
        <sense>
          <def>позволить</def>
        </sense>
      </item>
      <item>
        <form>
          <orth xml:lang="slk">слвц. <ref>dovolW</ref> то же</orth>
        </form>
        <cit type="bibl">
          <bibl>(SSJ I, 317)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="hsb">в.-луж. <ref>dowolid</ref> то же</orth>
        </form>
        <cit type="bibl">
          <bibl>(Pfuhl 154)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="rus">русск. <ref>довблитъ</ref>
          </orth>
        </form>
        <sense>
          <def>продовольствовать, снабжать содержанием, при­ пасами, харчами, содержать; делать довольным, удовлетворять</def>
        </sense>
