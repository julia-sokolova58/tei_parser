        </cit>
        <cit type="bibl">
          <bibl>(там же)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Гринченко I, 430)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="bel">блр. <ref>дастаць</ref>
          </orth>
        </form>
        <sense>
          <def>достать, достать, вынуть, извлечь, удалить, раздобыть, дотя­ нуться, получить, нажить, получить</def>
        </sense>
      </item>
    </etym>
    <gramGrp>
      <gram>Сложение<ref type="etymon" target="do-25">*do</ref> (см.) и гл. <ref type="etymon" target="stati">*stati</ref> (см.).</gram>
