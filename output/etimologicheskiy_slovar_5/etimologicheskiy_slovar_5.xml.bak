  <entry xml:id="dbly">
    <pb n="210" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dbly</orth>
      <lemma>dbly</lemma>
    </form>
    <form type="reconstructed" xml:lang="ocs">
      <orth>род. п. -ъуе</orth>
