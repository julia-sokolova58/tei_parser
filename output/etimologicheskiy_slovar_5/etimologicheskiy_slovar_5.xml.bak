        </sense>
        <cit type="bibl">
          <bibl>(Pfuhl 167)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="dsb">н.-луж. <ref>druzys</ref>
          </orth>
        </form>
        <sense>
