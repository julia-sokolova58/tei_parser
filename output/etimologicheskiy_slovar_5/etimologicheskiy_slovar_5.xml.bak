        </cit>
      </item>
    </etym>
    <gramGrp>
      <gram>Производное от гл.<ref type="etymon" target="dozbreti">*dozbreti</ref> / <ref type="etymon" target="dozirati">*dozirati</ref> (см.).</gram>
    </gramGrp>
  </entry>
