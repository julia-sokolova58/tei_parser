        </sense>
        <cit type="bibl">
          <bibl>(Даль 3 I, 1050; Филин 7, 303; Деулинский сло­ варь 138)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Словарь говоров Подмос­ ковья 104)</bibl>
        </cit>
      </item>
    </etym>
