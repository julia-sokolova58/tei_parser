      <item>
        <form>
          <orth xml:lang="ces" type="dialect">диал. <ref>duzi</ref> то же</orth>
        </form>
        <cit type="bibl">
          <bibl>(ляш., Bartos. Slov. 73)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="slk">слвц. <ref>duzi</ref>, прилаг.</orth>
