  <entry xml:id="dombskbjb">
    <pb n="74" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dombskbjb</orth>
      <lemma>dombskbjb</lemma>
    </form>
    <etym type="cognates">
      <item>
