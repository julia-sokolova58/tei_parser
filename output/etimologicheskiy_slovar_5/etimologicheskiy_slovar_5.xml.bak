          <orth xml:lang="rus" type="dialect">русск. диал. <ref>дупля</ref>
          </orth>
        </form>
        <sense>
          <def>дупло , дупгя ж. р. дупло дерева (новг., яросл.), дуплистое дерево (волог., новг., яросл.), ягодицы (смол.)</def>
        </sense>
