    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="chu" type="old">ст.-слав. <ref>ДоуыДБъ</ref> м. p. Aavo6[3ioc, "Ia-pog, Danubius, Ister</orth>
        </form>
