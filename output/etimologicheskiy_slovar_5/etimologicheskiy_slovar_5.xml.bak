        <cit type="bibl">
          <bibl>(Стойчев БД II, 156)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="srp">сербохорв. <ref>dm</ref> м. р.</orth>
        </form>
