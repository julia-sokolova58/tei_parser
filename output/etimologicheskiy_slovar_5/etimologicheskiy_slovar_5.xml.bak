        </cit>
        <cit type="bibl">
          <bibl>(Куликовский 145)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Васнецов 63)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Филин 8, 261)</bibl>
        </cit>
      </item>
      <item>
