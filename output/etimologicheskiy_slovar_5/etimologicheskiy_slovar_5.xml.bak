          <def>домовый, домовой , domov м. р. родина, родной дом</def>
        </sense>
        <cit type="bibl">
          <bibl>(SSJ I, 294, 296)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(там же)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="hsb">в.-луж. <ref>domowy</ref> то</orth>
        </form>
        <cit type="bibl">
          <bibl>(Pfuhl 132)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="pol">польск. <ref>domowy</ref>, прилаг.</orth>
        </form>
        <sense>
          <def>домовый, домовой, домаш­ ний, семейный</def>
        </sense>
        <cit type="bibl">
          <bibl>(Dorosz. И, 245—246)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="svc">словин. <ref>demugvi</ref>, прилаг. домовый</orth>
        </form>
