  <entry xml:id="dbrskati">
    <pb n="226" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dbrskati</orth>
      <lemma>dbrskati</lemma>
    </form>
    <form type="reconstructed" xml:lang="ocs">
