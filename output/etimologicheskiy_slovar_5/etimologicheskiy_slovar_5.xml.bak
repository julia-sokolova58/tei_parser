  <entry xml:id="dblbiti">
    <pb n="206" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dblbiti</orth>
      <lemma>dblbiti</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>длъб</ref>\к</orth>
