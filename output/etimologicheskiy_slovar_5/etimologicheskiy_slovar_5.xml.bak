        </sense>
        <cit type="bibl">
          <bibl>(Gebauer I, 327)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ces" type="old">ст.-чеш. <ref>drdzn</ref> ж. р.</orth>
        </form>
        <sense>
