        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ukr">укр. <ref>дохнути</ref>
          </orth>
        </form>
        <sense>
          <def>вздохнуть , дох- пути издыхать, дохнуть , дхнути дохнуть</def>
        </sense>
        <cit type="bibl">
          <bibl>(Гринченко I, 435)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(там же)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Гринченко I, 461)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="bel">блр. <ref>дбхнуць</ref>
          </orth>
        </form>
        <sense>
          <def>издыхать</def>
        </sense>
        <cit type="bibl">
          <bibl>(Байкоу-Некраш. 97)</bibl>
        </cit>
      </item>
    </etym>
    <gramGrp>
      <pos>verb</pos>
      <gram>Гл. на<m type="suffix">
          <ref>-ngti</ref>
        </m>, соотносительный с <ref type="etymon" target="dbxati">*dbxati</ref> (см.).</gram>
    </gramGrp>
  </entry>
  <entry xml:id="dbxorb">
    <pb n="177" end_page="178" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dbxorb</orth>
      <lemma>dbxorb</lemma>
    </form>
    <etym type="cognates">
      <item>
