          <bibl>(арх., Опыт 46; Подвысоцкий 37; Филин 8, 26)</bibl>
        </cit>
      </item>
    </etym>
    <note>Расширение (ь/е: -ъ) основы<xr type="compare">см. <ref type="etymon" target="dbrtb">*dbrtb</ref>
      </xr>.</note>
  </entry>
  <entry xml:id="dbrzati">
    <pb n="227" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dbrzati</orth>
      <lemma>dbrzati</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="chu" type="old">ст.-слав. <ref>Д</ref>^АЗЛТИ, Д^ЪЗДТИ ftappelv, xoXfj-av, audere, confidere</orth>
        </form>
