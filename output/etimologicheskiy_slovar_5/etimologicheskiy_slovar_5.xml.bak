          </orth>
        </form>
        <sense>
          <def>держать , zarzae то же</def>
        </sense>
        <cit type="bibl">
          <bibl>(Pfuhl 185)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Muka St. II, 1173)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="pol" type="old">польск. стар, <ref>dzierzec</ref>
          </orth>
        </form>
