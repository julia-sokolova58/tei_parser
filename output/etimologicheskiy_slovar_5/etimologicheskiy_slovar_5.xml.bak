        </form>
        <sense>
          <def>неровный, шершавый, шеро­ ховатый (Ст.-чеш., Прага)</def>
        </sense>
      </item>
      <item>
        <form>
          <orth xml:lang="ces">чеш. <ref>drsny</ref>, прилаг. то же</orth>
        </form>
