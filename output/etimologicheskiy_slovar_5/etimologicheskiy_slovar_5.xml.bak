  <entry xml:id="dogbnati">
    <pb n="51" end_page="52" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>dogbnati</orth>
      <lemma>dogbnati</lemma>
    </form>
    <form type="reconstructed" xml:lang="ocs">
