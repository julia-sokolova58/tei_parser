          </orth>
        </form>
        <sense>
          <def>очаг</def>
        </sense>
        <cit type="bibl">
          <bibl>(нижневардарские говоры, К. Пеев MJ X X I , 1970, 132)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="srp" type="old">сербохорв. стар, <ref>дймнйк</ref> м. р.</orth>
        </form>
        <sense>
