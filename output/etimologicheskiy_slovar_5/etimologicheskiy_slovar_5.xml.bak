        </cit>
        <cit type="bibl">
          <bibl>(Т. Бояджиев. Гюмюрджинско. — БД VI, 24; Д. Евстатиева. С. Тръстеник, Плевенско. — БД VI, 168; с. Огнен, Бургаско, дип. раб., Архив Софийск. ун-та)</bibl>
        </cit>
