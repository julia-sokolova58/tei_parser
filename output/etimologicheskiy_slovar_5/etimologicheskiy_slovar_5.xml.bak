          <bibl>(там же)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ces">чеш. <ref>del</ref> ж. р. то же</orth>
        </form>
      </item>
      <item>
        <form>
          <orth xml:lang="dsb">н.-луж. <ref>del</ref>, род. п. dli, ж. р., только в нареч. (we)dli</orth>
        </form>
