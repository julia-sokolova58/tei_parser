        </sense>
        <cit type="bibl">
          <bibl>(Гълъбов БД II, 76)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Д. Евста- тиева. С. Тръстеник, Плевенско. — БД VI, 169)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Божкова БД I, 246)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Т. Стойчев. Родопски речник. — БД V, 167)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="mac">макед. <ref>дрдори</ref>
          </orth>
        </form>
        <sense>
          <def>болтать, трепать языком</def>
