          <bibl>(Dorosz. II, 1367)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="pol" type="dialect">диал. <ref>gcorp</ref> то же</orth>
        </form>
        <cit type="bibl">
          <bibl>(Tomasz. fcop. 124)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="chu">цслав. <ref>гърбъ</ref>, гръбъ, горбъ</orth>
        </form>
        <sense>
