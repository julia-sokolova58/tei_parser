          </orth>
        </form>
        <sense>
          <def>невежество , вред, ущерб, насилие, обида , враждебность, непослушание , нечистота, зловоние</def>
        </sense>
        <cit type="bibl">
          <bibl>(Нест. Бор. Гл. 1, 48; Панд. Ант. XI в. 2; Дан. иг., Срезневский I, 598—599)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(1480 г., Псков, лет. II, 59)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(1471 г., Новг. II лет. 279)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Назиратель 147, XVI в.)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(СлРЯ XI—XVII вв. 4, 144)</bibl>
        </cit>
