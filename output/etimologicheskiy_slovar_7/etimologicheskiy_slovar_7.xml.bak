  <entry xml:id="gyliti">
    <pb n="220" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>gyliti</orth>
      <lemma>gyliti</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
