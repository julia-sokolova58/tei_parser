  <entry xml:id="gybn9ti">
    <pb n="217" end_page="218" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>gybn9ti</orth>
      <lemma>gybn9ti</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>гйна</ref>
          </orth>
        </form>
        <sense>
          <def>гибнуть, погибать</def>
        </sense>
        <cit type="bibl">
          <bibl>(БТР; Геров: гыбнж)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="bul" type="dialect">диал. <ref>гйбна</ref> то же (Речник РОДД), гйбна</orth>
        </form>
        <sense>
          <def>задеть, пошевелить , гйнем гибнуть, пропадать, умирать</def>
        </sense>
        <cit type="bibl">
          <bibl>(Младенов БТР)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Шапка- рев— Близнев БД III, 208)</bibl>
        </cit>
      </item>
