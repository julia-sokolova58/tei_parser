        </m> от <ref type="etymon" target="gora">*gora</ref> (см.).
• g o r i k v e t b</gram>
    </gramGrp>
  </entry>
  <entry xml:id="gorikvetb">
    <pb n="45" />
    <form type="reconstructed" xml:lang="ocs">
