        </form>
        <sense>
          <def>шишка, сук , grca ж. p. опухоль, шишка , grca опухоль, шишка, пук, клок</def>
        </sense>
        <cit type="bibl">
          <bibl>(Bartos. Slov. 106; Hosek. Ceskomorav. II, 147; Gregor. Slov. slavk.-bucov. 64; Malina. Mistr. 34; Konif. Slov. morav. 288; Sverak. Boskov. 112)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Gregor. Slov. slavk.-bucov. 56)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Belie. Dolsk. 174)</bibl>
        </cit>
      </item>
      <item>
