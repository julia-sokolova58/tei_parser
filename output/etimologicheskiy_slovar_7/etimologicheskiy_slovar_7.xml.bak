  <entry xml:id="gblka">
    <pb n="190" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>gblka</orth>
      <lemma>gblka</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>гълка</ref> ж. р.</orth>
        </form>
        <sense>
          <def>опухоль желез , глъка ж. р. железа под челюстью (Дювернуа)</def>
        </sense>
        <cit type="bibl">
