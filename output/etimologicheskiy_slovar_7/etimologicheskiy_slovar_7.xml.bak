        <form>
          <orth xml:lang="slk">слвц. <ref>hfdaf</ref> книжн. редк. то же .—Ср., далее, производное</orth>
        </form>
        <cit type="bibl">
          <bibl>(SSJ I, 522)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="rus" type="dialect">русск. диал. <ref>гордан</ref> м. р.</orth>
        </form>
        <sense>
