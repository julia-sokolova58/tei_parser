        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="pol" type="dialect">диал. <ref>gronostajek</ref>
          </orth>
        </form>
        <cit type="bibl">
          <bibl>(Maciejewski. Chetm.-dobrz. 63)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="rus" type="old">др.-русск. <ref>горносталь</ref> , горностаи , орностаи , Горностай, личное имя собств.</orth>
        </form>
        <cit type="bibl">
          <bibl>(Дух. Салтык. 1483 г.; Уст. Важ. гр. 1552 г., Срезневский I, 554)</bibl>
        </cit>
