        </sense>
        <cit type="bibl">
          <bibl>(И-С)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="srp">сербохорв. <ref>glzdau</ref>, прилаг.</orth>
        </form>
        <sense>
          <def>нарядный, изящный, пышный, горделивый</def>
