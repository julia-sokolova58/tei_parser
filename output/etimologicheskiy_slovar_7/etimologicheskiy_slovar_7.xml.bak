      </item>
      <item>
        <form>
          <orth xml:lang="slv">словен. <ref>grm</ref> м. р.</orth>
        </form>
        <sense>
          <def>куст , сюда же производные grmiica ж. р. скуча, ком, grmdlja ж. р. то же</def>
        </sense>
        <cit type="bibl">
