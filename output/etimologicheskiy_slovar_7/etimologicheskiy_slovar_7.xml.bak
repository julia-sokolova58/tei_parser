    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>главнйк</ref> м. р.</orth>
        </form>
        <sense>
          <def>хозяин дома, главарь, предводитель, ступица, fдонный обруч бочки , главник жених (Ге- ров — Панчев)</def>
        </sense>
