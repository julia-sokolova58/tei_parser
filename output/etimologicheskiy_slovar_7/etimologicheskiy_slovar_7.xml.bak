        </sense>
        <cit type="bibl">
          <bibl>(SSJ I, 519)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="dsb">н.-луж. <ref>granica</ref> ж. р.</orth>
        </form>
