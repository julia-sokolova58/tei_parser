    </form>
    <form type="reconstructed" xml:lang="ocs">
      <orth>gqditi</orth>
      <lemma>gqditi</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>гудя</ref>
          </orth>
        </form>
        <sense>
          <def>гудеть</def>
        </sense>
