          <orth xml:lang="slv">словен. <ref>gibezljlv</ref>, прилаг.</orth>
        </form>
        <sense>
          <def>ловкий, изворотливый</def>
        </sense>
        <cit type="bibl">
          <bibl>(Plet. I 209)</bibl>
        </cit>
      </item>
    </etym>
    <gramGrp>
      <gram>Производное с суф.<m type="suffix">
          <ref>-еъъ</ref>
        </m> от гл. <ref type="etymon" target="gybiti">*gybiti</ref> 
(см.).</gram>
    </gramGrp>
  </entry>
  <entry xml:id="gybeti">
