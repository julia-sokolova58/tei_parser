        </cit>
        <cit type="bibl">
          <bibl>(М. Младенов БД III, 53)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Д. Евстатиева. С. Тръстеник, Плевенско. — Б Д VI, 165)</bibl>
        </cit>
