        </form>
        <sense>
          <def>ласка (зверок) , также grdnozelj, род. п. -zlja, м. р. , grdnezelj, род. п. -zlja, м. р</def>
        </sense>
        <cit type="bibl">
          <bibl>(Plet. I, 245)</bibl>
        </cit>
        <cit type="bibl">
