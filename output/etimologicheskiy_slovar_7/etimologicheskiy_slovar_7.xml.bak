        </cit>
        <cit type="bibl">
          <bibl>(Копорский. О говоре се­ вера Пошехоно-Володарского уезда Ярославской губернии 103)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Мельниченко 53)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Филин 6, 345)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(волог., Опыт 38)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(юж.. Даль 3 I, 843; Филин 6, 121)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(арх., Филин 6, 123)</bibl>
        </cit>
      </item>
    </etym>
