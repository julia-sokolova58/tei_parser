        <cit type="bibl">
          <bibl>(Гринченко I, 328)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="bel">блр. <ref>грбнка</ref> ж. р.</orth>
        </form>
        <sense>
