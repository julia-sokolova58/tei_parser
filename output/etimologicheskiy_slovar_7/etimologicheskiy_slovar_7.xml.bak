          <bibl>(SSJ I, 536)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="hsb">в.-луж. <ref>hudzic</ref>
          </orth>
        </form>
        <sense>
          <def>играть (в т. ч. на скрипке)</def>
