        </form>
        <cit type="bibl">
          <bibl>(Й. Займов. Заселване на бъл- гарските славяни на Балканския полуостров. София, 1967, 11)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="srp">сербохорв. <ref>bezdan</ref>, род. п. bezdna, м. p., bezdan, род. п. bezdni, ж. p., brezdan, ж. р.</orth>
