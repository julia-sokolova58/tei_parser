  <entry xml:id="borna">
    <pb n="204" end_page="206" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>borna</orth>
      <lemma>borna</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>брака</ref> ж. р.</orth>
        </form>
        <sense>
          <def>борона</def>
        </sense>
        <cit type="bibl">
          <bibl>(БТР)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="bul" type="dialect">диал. <ref>брака</ref> ж. р. то же , брака ж. р.</orth>
        </form>
        <sense>
          <def>след</def>
        </sense>
        <cit type="bibl">
          <bibl>(Гълъбов БД II, 71; М. Младенов БД III, 41)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(Шапкарев — Близнев БД III, 204)</bibl>
        </cit>
      </item>
      <item>
        <form>
