          </orth>
        </form>
      </item>
      <item>
        <form>
          <orth xml:lang="srp" type="dialect">диал. <ref>бйлило</ref>, б)елило ср. р.</orth>
        </form>
        <sense>
          <def>место для отбеливания полотна, белила</def>
        </sense>
      </item>
      <item>
        <form>
          <orth xml:lang="slv">словен. <ref>ЬеШо</ref> ср. р.</orth>
        </form>
        <sense>
          <def>белая краска; белила, побелка, отбеливание</def>
        </sense>
