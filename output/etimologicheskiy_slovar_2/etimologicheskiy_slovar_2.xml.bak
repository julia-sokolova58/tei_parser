      <lemma>bezdbbnbnb(jb)</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>бездънен</ref>, прилаг.,</orth>
        </form>
        <sense>
          <def>бездонный, очень глу­ бокий</def>
        </sense>
        <cit type="bibl">
          <bibl>(БТР; Геров: бездънный)</bibl>
        </cit>
      </item>
      <item>
        <form>
