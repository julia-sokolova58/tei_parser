  <entry xml:id="borvina">
    <pb n="214" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>borvina</orth>
      <lemma>borvina</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="srp">сербохорв. <ref>бравина</ref> ж. р.</orth>
        </form>
        <sense>
          <def>баранина, козлятина</def>
        </sense>
        <cit type="bibl">
          <bibl>(РСА И, 90)</bibl>
        </cit>
      </item>
      <item>
        <form>
