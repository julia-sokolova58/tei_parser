          <orth xml:lang="ces">чеш. <ref>bludny</ref>, прилаг.</orth>
        </form>
        <sense>
          <def>блуждающий, бродячий, ошибочный</def>
        </sense>
      </item>
      <item>
        <form>
          <orth xml:lang="slk">слвц. <ref>bludny</ref>, прилаг.</orth>
        </form>
        <sense>
          <def>ошибочный, блуждающий</def>
        </sense>
        <cit type="bibl">
          <bibl>(SSJ I, 107)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="hsb">в.-луж. <ref>Ыudny</ref>
          </orth>
        </form>
        <sense>
          <def>ошибочный</def>
        </sense>
        <cit type="bibl">
          <bibl>(Pfuhl 29)</bibl>
        </cit>
      </item>
