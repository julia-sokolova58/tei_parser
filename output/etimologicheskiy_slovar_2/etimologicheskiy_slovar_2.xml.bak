          <orth xml:lang="dsb">н.-луж. <ref>bludny</ref>
          </orth>
        </form>
        <sense>
          <def>помешанный, ошибочный, сумасшедший, бро­ дячий; странствующий,погрешный, ошибочный</def>
        </sense>
        <cit type="bibl">
          <bibl>(Muka SI. I, 45)</bibl>
        </cit>
      </item>
