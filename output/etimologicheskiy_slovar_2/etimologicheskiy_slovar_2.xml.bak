        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="rus">русск. <ref>боязнь</ref> ж. р.</orth>
        </form>
        <sense>
          <def>беспокойство, страх</def>
        </sense>
      </item>
      <item>
        <form>
          <orth xml:lang="ukr" type="old">ст.-укр. <ref>боязнь</ref> ж. р.</orth>
        </form>
