      <lemma>blazniti (sč)</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="chu" type="old">ст.-слав. <ref>БЛДЗЫИТИ</ref> ашхтау, rceipaOstv, iroXep-eTv, decipere, tentare</orth>
