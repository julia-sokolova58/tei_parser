  <entry xml:id="boguxvalb">
    <pb n="160" end_page="161" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>boguxvalb</orth>
      <lemma>boguxvalb</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="ces" type="old">ст.-чеш. <ref>Bohachval</ref> м. р., личное имя собств.</orth>
        </form>
