  <entry xml:id="bodakb">
    <pb n="152" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>bodakb</orth>
      <lemma>bodakb</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="slv">словен. <ref>boddk</ref> м. р.</orth>
        </form>
        <sense>
          <def>колющее оружие, штык, чертополох</def>
        </sense>
