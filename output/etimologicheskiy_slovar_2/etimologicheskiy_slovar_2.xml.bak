          <orth xml:lang="srp">сербохорв. <ref>блекётати</ref>
          </orth>
        </form>
        <sense>
          <def>блеять</def>
        </sense>
        <cit type="bibl">
          <bibl>(РСА I, 641)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="slv">словен. <ref>blekotdti</ref>
          </orth>
        </form>
