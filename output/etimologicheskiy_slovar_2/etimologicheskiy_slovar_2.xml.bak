  <entry xml:id="bludo">
    <pb n="132" end_page="135" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>bl'udo</orth>
      <lemma>bl'udo</lemma>
    </form>
    <form type="reconstructed" xml:lang="ocs">
      <orth>bl'udb</orth>
      <lemma>bl'udb</lemma>
    </form>
    <etym type="cognates">
      <item>
