          <bibl>(Plet. I, 42)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ces">чеш. <ref>bojny</ref>
          </orth>
        </form>
        <sense>
          <def>боевой</def>
        </sense>
