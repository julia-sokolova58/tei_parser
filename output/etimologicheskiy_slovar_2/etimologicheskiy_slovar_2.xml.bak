  <entry xml:id="bosonogTjb">
    <pb n="222" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>bosonogT&gt;(jb)</orth>
      <lemma>bosonogT&gt;(jb)</lemma>
    </form>
    <etym type="cognates">
      <item>
        <form>
          <orth xml:lang="bul">болг. <ref>босоног</ref>, прилаг.</orth>
        </form>
        <sense>
          <def>босоногий</def>
        </sense>
