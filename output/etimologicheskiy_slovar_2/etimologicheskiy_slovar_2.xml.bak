        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ces">чеш. <ref>Bohumil</ref> м. р., личное имя собств., ср. также Bohumila ж. р.</orth>
        </form>
      </item>
      <item>
        <form>
          <orth xml:lang="hsb">в.-луж. <ref>Bohumil</ref>
          </orth>
        </form>
        <cit type="bibl">
          <bibl>(Zeman 28)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="pol">польск. <ref>Bogumil</ref>, мужское личное имя собств.</orth>
        </form>
      </item>
      <item>
        <form>
          <orth xml:lang="rus" type="old">др.-русск. <ref>Богомилъ</ref>
          </orth>
        </form>
        <cit type="bibl">
          <bibl>(1612 г., Тупиков 112)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="bel">блр. <ref>Багу</ref> мы , сюда же</orth>
        </form>
        <cit type="bibl">
          <bibl>(Слоушк асабовых уласных iMeH 20)</bibl>
        </cit>
      </item>
      <item>
