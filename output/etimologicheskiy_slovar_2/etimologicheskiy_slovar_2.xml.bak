    <gramGrp>
      <gram>Суффиксальное производное (<m type="suffix">
          <ref>-t-ъсъ</ref>
        </m>) в функции имени деятеля, 
названия орудия от основы гл. <ref type="etymon" target="biti">*biti</ref> (см.).</gram>
    </gramGrp>
  </entry>
  <entry xml:id="bitbje">
    <pb n="102" />
    <form type="reconstructed" xml:lang="ocs">
      <orth>bitbje</orth>
