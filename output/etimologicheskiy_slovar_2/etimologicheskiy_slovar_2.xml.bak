        </sense>
        <cit type="bibl">
          <bibl>(Plet. I, 34)</bibl>
        </cit>
        <cit type="bibl">
          <bibl>(там же)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="ces">чеш. <ref>blekotati</ref>
          </orth>
        </form>
