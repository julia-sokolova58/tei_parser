          <bibl>(Banska Bystrica, Kalal 35)</bibl>
        </cit>
      </item>
      <item>
        <form>
          <orth xml:lang="pol">польск. <ref>borowiec</ref>, род. п. -wca, м. р.</orth>
        </form>
